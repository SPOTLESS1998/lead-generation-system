{
  "client_name": "Ejentic AI",
  "from_name": "Ejentic AI",
  "reply_to": null,
  "physical_address": "Ejentic AI, 12 Admiralty Way, Lekki Phase 1, Lagos (DEMO address — replace before any live send)",
  "unsubscribe_base_url": "http://localhost:5001",
  "copy_provider": "gemini",
  "providers": ["freellmapi", "gemini", "nvidia"],
  "freellmapi_model": ["mistral-medium-latest", "command-a-03-2025"],
  "demo_mode": false,
  "lead_source": "csv",
  "timezone": "Africa/Lagos",
