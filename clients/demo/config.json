    "action_slug": "GOOGLECALENDAR_CREATE_EVENT"
  },
  "reminders": {
    "enabled": true,
    "lead_times_min": [60, 30, 15],
    "poll_seconds": 60,
    "email": true,
    "desktop": true
  },
  "sending": {
    "mode": "controlled",
    "controlled_inbox_env": "SMTP_USER",
    "daily_global_cap": 50,
    "throttle_seconds": { "min": 3, "max": 6 },
    "mailboxes": [
      {
        "smtp_host": "smtp.gmail.com",
        "smtp_port": 587,
        "user_env": "SMTP_USER",
        "pass_env": "SMTP_PASS",
        "daily_cap": 40
      }
    ]
  }
}
