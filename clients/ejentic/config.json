{
  "client_name": "Ejentic AI",
  "from_name": "Ejentic AI Outreach",
  "reply_to": null,
  "physical_address": "REPLACE-ME: your business postal address (required by CAN-SPAM before real sends)",
  "unsubscribe_base_url": "http://localhost:5001",
  "copy_provider": "gemini",
  "gemini_model": "gemini-2.5-flash",
  "nvidia_model": "meta/llama-3.1-70b-instruct",
  "demo_mode": false,
  "lead_source": "maps_firecrawl",
  "discovery": {
    "segments": [
      {
        "name": "Multilingual customer support",
        "service": "Localized Multilingual Support Agents",
        "queries": [
          "e-commerce companies in Lagos, Nigeria",
          "online fashion stores in Lagos, Nigeria",
          "travel agencies in Lagos, Nigeria"
        ]
      },
      {
        "name": "Lead generation",
        "service": "AI Lead Generation System",
        "queries": [
          "real estate agencies in Lagos, Nigeria",
          "digital marketing agencies in Lagos, Nigeria",
          "real estate agencies in Abuja, Nigeria"
        ]
      },
      {
        "name": "Knowledge base / RAG",
        "service": "Air-Gapped Internal Knowledge Base (RAG)",
        "queries": [
          "law firms in Lagos, Nigeria",
          "accounting firms in Lagos, Nigeria",
          "audit firms in Lagos, Nigeria"
        ]
      },
      {
        "name": "Workflow automation",
        "service": "Enterprise Workflow Automation",
        "queries": [
          "logistics companies in Lagos, Nigeria",
          "payroll and HR services in Lagos, Nigeria",
          "tax consultants in Lagos, Nigeria"
        ]
      }
    ],
    "max_results": 10,
    "max_leads": 50,
    "require_email": true,
    "scrape_pages": ["", "contact"],
    "max_workers": 3
  },
  "timezone": "Africa/Lagos",
  "booking": {
    "enabled": true,
    "provider": "composio_googlecalendar",
    "default_duration_min": 30,
    "action_slug": "GOOGLECALENDAR_CREATE_EVENT"
  },
  "sending": {
    "mode": "controlled",
    "controlled_inbox_env": "SMTP_USER",
    "daily_global_cap": 50,
    "throttle_seconds": { "min": 20, "max": 60 },
    "mailboxes": [
      {
        "smtp_host": "smtp.gmail.com",
        "smtp_port": 587,
        "user_env": "SMTP_USER",
        "pass_env": "SMTP_PASS",
        "daily_cap": 40
      }
    ]
  },
  "target_niches": [
    "local accounting firms lagos nigeria",
    "real estate agencies abuja",
    "e-commerce fashion stores nigeria"
  ]
}
